---
interface Props {
  actif?: 'accueil' | 'projets' | 'methode' | 'a-propos';
}
const { actif } = Astro.props;
const liens = [
  { href: '/projets/', label: 'Nomenclature', cle: 'projets' },
  { href: '/methode/', label: 'Méthode', cle: 'methode' },
  { href: '/a-propos/', label: 'À propos', cle: 'a-propos' }
] as const;
---

<header class="en-tete">
  {/* Correction gamma du logo en calque : fonce le verre, garde le fond blanc pur (donc invisible en multiply) */}
  <svg class="filtres" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="marque-gamma" color-interpolation-filters="sRGB">
      <feComponentTransfer>
        <feFuncR type="gamma" exponent="2.2"></feFuncR>
        <feFuncG type="gamma" exponent="2.2"></feFuncG>
        <feFuncB type="gamma" exponent="1.6"></feFuncB>
      </feComponentTransfer>
    </filter>
  </svg>
  <div class="page">
    <a class="marque" href="/" aria-label="L@uL@b, accueil">
      {/* Logo LF en rotation, la marque de fabrique : gardé d'une page à l'autre, il ne repart pas de zéro */}
      <span class="marque-logo" aria-hidden="true" transition:persist="marque-logo">
        <video src="/videos/marque/logo-lf.mp4" poster="/videos/marque/logo-lf.jpg" width="120" height="120" muted loop playsinline preload="auto" data-marque-logo></video>
      </span>
      L@uL@b
      <small>Laurent Feroux · Sanguinet</small>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {liens.map((l) => (
        <a href={l.href} aria-current={actif === l.cle ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
      <button class="bascule" type="button" data-bascule-theme aria-live="polite">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
          <path d="M8 1.5 A6.5 6.5 0 0 1 8 14.5 Z" fill="currentColor"></path>
        </svg>
        <span class="si-cyano">Calque</span>
        <span class="si-calque">Cyanotype</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Le logo ne tourne que lorsqu'il est à l'écran ; prefers-reduced-motion le laisse arrêté.
  function brancherLogo(video: HTMLVideoElement) {
    if (video.dataset.pret) return;
    video.dataset.pret = '1';
    let visible = false;
    const maj = () => {
      if (visible && !reduit.matches) video.play().catch(() => {});
      else if (!video.paused) video.pause();
    };
    new IntersectionObserver((entries) => {
      visible = entries.some((e) => e.isIntersecting);
      maj();
    }).observe(video);
    reduit.addEventListener('change', maj);
  }

  function init() {
    document.querySelectorAll<HTMLVideoElement>('[data-marque-logo]').forEach(brancherLogo);
    document.querySelectorAll<HTMLButtonElement>('[data-bascule-theme]').forEach((b) => {
      if (b.dataset.pret) return;
      b.dataset.pret = '1';
      b.addEventListener('click', () => {
        const html = document.documentElement;
        const suivant = html.dataset.theme === 'calque' ? 'cyanotype' : 'calque';
        html.dataset.theme = suivant;
        try {
          localStorage.setItem('laulab-theme', suivant);
        } catch {
          /* stockage indisponible : le choix ne survit pas à la page */
        }
      });
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
