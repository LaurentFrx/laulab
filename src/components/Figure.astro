---
/**
 * Aiguillage vers le dessin d'un projet.
 * Ajouter un dessin : créer figures/<Nom>.astro et l'inscrire dans la table ci-dessous.
 */
import Jansen from './figures/Jansen.astro';
import Cumulus from './figures/Cumulus.astro';
import Solaire from './figures/Solaire.astro';
import Meteo from './figures/Meteo.astro';
import Led from './figures/Led.astro';
import Cube from './figures/Cube.astro';
import Compteur from './figures/Compteur.astro';
import LogoLF from './figures/LogoLF.astro';
import Chevalet from './figures/Chevalet.astro';
import Tazieff from './figures/Tazieff.astro';
import Clim from './figures/Clim.astro';
import Duck from './figures/Duck.astro';
import Humanoide from './figures/Humanoide.astro';
import Laser from './figures/Laser.astro';
import Soudure from './figures/Soudure.astro';
import Salle from './figures/Salle.astro';
import Serveur from './figures/Serveur.astro';
import Vps from './figures/Vps.astro';
import Imac from './figures/Imac.astro';
import Hass from './figures/Hass.astro';
import ACompleter from './figures/ACompleter.astro';

interface Props {
  nom?: string;
  mode?: 'planche' | 'vignette';
  legende?: string;
  titre?: string;
  tracer?: boolean;
}
const { nom, mode = 'planche', legende, titre, tracer = true } = Astro.props;
const figures: Record<string, any> = {
  jansen: Jansen,
  cumulus: Cumulus,
  solaire: Solaire,
  meteo: Meteo,
  led: Led,
  cube: Cube,
  compteur: Compteur,
  logo: LogoLF,
  chevalet: Chevalet,
  tazieff: Tazieff,
  clim: Clim,
  duck: Duck,
  humanoide: Humanoide,
  laser: Laser,
  soudure: Soudure,
  salle: Salle,
  serveur: Serveur,
  vps: Vps,
  imac: Imac,
  hass: Hass
};
const Composant = nom ? figures[nom] : undefined;
---

{Composant ? <Composant mode={mode} legende={legende} tracer={tracer} /> : <ACompleter mode={mode} titre={titre} />}

<script>
  // Hors de l'écran, les dessins animés attendent (voir figures-animees.css)
  let veille: IntersectionObserver | undefined;
  const surveiller = () => {
    veille?.disconnect();
    if (!('IntersectionObserver' in window)) return;
    veille = new IntersectionObserver(
      (vues) => {
        for (const v of vues) v.target.toggleAttribute('data-hors-vue', !v.isIntersecting);
      },
      { rootMargin: '80px' }
    );
    document.querySelectorAll('.figure.anime').forEach((f) => veille!.observe(f));
  };
  document.addEventListener('astro:page-load', surveiller);
</script>
