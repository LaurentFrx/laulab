---
/** Home Assistant, avant Domo : ce qu'il reliait dans la maison, ce qui a servi de banc d'essai, et ce qui l'a remplacé. */
import Bulle from './Bulle.astro';
import Marqueur from './Marqueur.astro';

interface Props {
  mode?: 'planche' | 'vignette';
  tracer?: boolean;
  legende?: string;
}
const { mode = 'planche', tracer = true, legende } = Astro.props;
const materiel = [
  { y: 52, nom: 'Shelly' },
  { y: 78, nom: 'onduleur' },
  { y: 104, nom: 'batteries' }
];
---

<figure class:list={['figure', 'hass', { vignette: mode === 'vignette' }]} data-trace={tracer ? '' : undefined}>
  <svg viewBox="0 0 220 150" role="img" aria-label="Une maison : Home Assistant, barré, relié au matériel (Shelly, onduleur, batteries) et au cumulus ; à droite, les automatisations YAML, le relais de notifications push, et Domo qui remplace le tout en juin 2026">
    <defs><Marqueur id="f-hass" /></defs>

    <!-- La maison -->
    <path class="fort" d="M12 44 L70 14 L128 44"></path>
    <rect class="fort" x="18" y="44" width="104" height="78"></rect>

    <!-- Home Assistant, au centre -->
    <circle class="fort" cx="84" cy="72" r="11"></circle>
    <circle class="fin" cx="84" cy="72" r="3"></circle>
    <text class="texte-legende" x="62" y="55">Home Assistant</text>

    <!-- Le matériel -->
    {materiel.map((m) => (
      <>
        <rect class="moyen" x="24" y={m.y} width="24" height="11"></rect>
        <text class="texte-legende" x="26.5" y={m.y + 7}>{m.nom}</text>
        <line class="fin" x1="48" y1={m.y + 5.5} x2={m.y === 78 ? 73 : 75.5} y2={m.y === 52 ? 66 : m.y === 78 ? 74 : 79}></line>
      </>
    ))}

    <!-- Le cumulus -->
    <line class="fin" x1="84" y1="83" x2="84" y2="94"></line>
    <rect class="moyen" x="76" y="94" width="16" height="24" rx="6"></rect>
    <text class="texte-legende" x="95" y="108">cumulus</text>

    <!-- Il n'est plus utilisé -->
    <path class="crayon" d="M73 61 l22 22 M95 61 l-22 22"></path>

    <!-- Automatisations YAML -->
    <line class="fin" x1="94.5" y1="68" x2="150" y2="34"></line>
    <rect class="moyen" x="150" y="14" width="50" height="36"></rect>
    <path class="fin" d="M154 21h22 M158 26h32 M158 31h24 M162 36h32 M158 41h20 M154 46h26"></path>
    <text class="texte-legende" x="150" y="56">automatisations YAML</text>

    <!-- Relais de notifications push -->
    <line class="fin" x1="95" y1="73" x2="150" y2="73"></line>
    <rect class="moyen" x="150" y="67" width="14" height="12"></rect>
    <path class="cache" d="M168 69.5 a4 4 0 0 1 0 7"></path>
    <path class="cache" d="M172 67 a7.5 7.5 0 0 1 0 12"></path>
    <rect class="moyen" x="186" y="63" width="11" height="20" rx="2"></rect>
    <text class="texte-legende" x="150" y="90">relais de notifications push</text>

    <!-- Domo prend la suite -->
    <line class="moyen" x1="122" y1="112" x2="149" y2="112" marker-end="url(#f-hass)"></line>
    <rect class="fort" x="150" y="100" width="56" height="26"></rect>
    <text class="texte-legende" x="154" y="111">Domo</text>
    <text class="texte-legende" x="154" y="119">remplace le tout, juin 2026</text>

    <!-- Repères -->
    <Bulle n="1" x="108" y="90" ax="93" ay="79" />
    <Bulle n="2" x="8" y="84" ax="24" ay="84" />
    <Bulle n="3" x="64" y="112" ax="76" ay="108" />
    <Bulle n="4" x="212" y="22" ax="200" ay="26" />
    <Bulle n="5" x="210" y="66" ax="197" ay="70" />
    <Bulle n="6" x="212" y="136" ax="204" ay="126" />
  </svg>
  {legende && <figcaption>{legende}</figcaption>}
</figure>
