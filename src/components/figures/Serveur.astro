---
/** Serveur maison : le Raspberry Pi et ses services, le SSD, Tailscale vers les appareils, et la migration depuis iCloud. */
import Bulle from './Bulle.astro';
import Marqueur from './Marqueur.astro';

interface Props {
  mode?: 'planche' | 'vignette';
  tracer?: boolean;
  legende?: string;
}
const { mode = 'planche', tracer = true, legende } = Astro.props;
const services = [
  { x: 84, y: 58, nom: 'Nextcloud' },
  { x: 113, y: 58, nom: 'Plex' },
  { x: 84, y: 80, nom: 'MariaDB' },
  { x: 113, y: 80, nom: 'Redis' }
];
---

<figure class:list={['figure', 'serveur', { vignette: mode === 'vignette' }]} data-trace={tracer ? '' : undefined}>
  <svg viewBox="0 0 220 150" role="img" aria-label="Un Raspberry Pi 4 qui fait tourner Nextcloud, Plex, MariaDB et Redis dans Docker, avec un SSD Samsung T7 ; Tailscale le relie aux appareils ; un script Python transfère environ 660 Go depuis iCloud vers Nextcloud">
    <defs><Marqueur id="f-serveur" /></defs>

    <!-- Le Raspberry Pi -->
    <rect class="fort" x="78" y="38" width="66" height="68" rx="2"></rect>
    <text class="texte-legende" x="80" y="34">Raspberry Pi 4</text>
    <text class="texte-legende" x="84" y="50">Docker · Portainer</text>
    {services.map((s) => (
      <>
        <rect class="moyen" x={s.x} y={s.y} width="25" height="16"></rect>
        <text class="texte-legende" x={s.x + 2.5} y={s.y + 9.5}>{s.nom}</text>
      </>
    ))}

    <!-- Le SSD -->
    <line class="moyen" x1="144" y1="76" x2="170" y2="76"></line>
    <rect class="fort" x="170" y="64" width="40" height="24" rx="3"></rect>
    <text class="texte-legende" x="174" y="74">Samsung T7</text>
    <text class="texte-legende" x="174" y="81">exFAT · médias</text>
    <text class="texte-cote" x="150" y="72">USB</text>

    <!-- La migration depuis iCloud -->
    <path class="moyen" d="M18 33 a5.5 5.5 0 0 1 -1 -10.5 a6 6 0 0 1 11 -2.5 a7 7 0 0 1 12 3 a5 5 0 0 1 -1 10 Z"></path>
    <text class="texte-legende" x="44" y="22">iCloud</text>
    <text class="texte-cote" x="44" y="29">≈ 660 Go</text>
    <line class="moyen" x1="28" y1="33" x2="28" y2="51" marker-end="url(#f-serveur)"></line>
    <rect class="moyen" x="8" y="52" width="52" height="30"></rect>
    <text class="texte-legende" x="11" y="60">script Python · WebDAV</text>
    <text class="texte-legende" x="11" y="67">5 fichiers à la fois</text>
    <text class="texte-legende" x="11" y="74">manifeste + SHA-256</text>
    <line class="moyen" x1="60" y1="66" x2="83" y2="66" marker-end="url(#f-serveur)"></line>

    <!-- Tailscale, vers les appareils -->
    <polyline class="cache" points="111,106 111,118"></polyline>
    <polyline class="cache" points="84,126 84,118 150,118 150,126"></polyline>
    <line class="cache" x1="116" y1="118" x2="116" y2="124"></line>
    <text class="texte-cote" x="121" y="114">Tailscale</text>
    <rect class="moyen" x="80" y="126" width="8" height="15" rx="1.5"></rect>
    <rect class="moyen" x="107" y="124" width="18" height="16" rx="1.5"></rect>
    <rect class="moyen" x="140" y="126" width="20" height="12" rx="1"></rect>
    <line class="moyen" x1="136" y1="140" x2="164" y2="140"></line>

    <!-- Repères -->
    <Bulle n="1" x="154" y="34" ax="142" ay="40" />
    <Bulle n="2" x="66" y="96" ax="84" ay="92" />
    <Bulle n="3" x="200" y="52" ax="194" ay="64" />
    <Bulle n="4" x="178" y="118" ax="150" ay="118" />
    <Bulle n="5" x="20" y="98" ax="24" ay="82" />
  </svg>
  {legende && <figcaption>{legende}</figcaption>}
</figure>
