---
/** Atelier Jansenosaure, feuille 1 : le robot en 3D (visualiseur de l'atelier, three.js r128 servi par le site). */
import Atelier from '../../../../layouts/Atelier.astro';
import { contenu, scriptPanne } from '../../../../atelier/atelier';
---

<Atelier
  onglet="voir"
  accroche="Le dossier de fabrication du robot, tel que le produit son générateur : le modèle 3D qui marche, l'ordre de montage, les achats, les plateaux de découpe et les études. Il se met à jour seul à chaque nouvelle version."
>
  <section id="voir" class="at-onglet" data-actif="1" aria-label="Le robot en 3D" set:html={contenu('voir')} />
  {scriptPanne && <script is:inline set:html={scriptPanne} />}
  <script>
    import '../../../../atelier/demarrer';
  </script>
</Atelier>
