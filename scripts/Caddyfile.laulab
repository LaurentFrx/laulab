# Bloc Caddy pour laulab.feroux.fr — référence. Le Caddyfile du VPS (/etc/caddy/Caddyfile) fait foi :
# il peut contenir en plus la directive `log` du serveur. Le dossier dist/ est produit par scripts/deploy-vps.sh.
laulab.feroux.fr {
	root * /srv/laulab/dist
	encode zstd gzip

	# Fichiers commençant par un point (.git, .env…) : jamais servis
	@point path /.* /*/.*
	respond @point 404

	# Assets empreintés et polices : cache long. Le HTML, lui, reste revalidé à chaque visite.
	@assets path /_astro/* /fonts/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Icônes et manifeste : un jour de cache. iOS relit les icônes dans son cache au
	# moment de « Sur l'écran d'accueil » : servies en no-cache, il dessinait une lettre.
	@icones path /icones/* /apple-touch-icon.png /apple-touch-icon-precomposed.png /favicon.ico /manifest.json
	header @icones Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
	header /manifest.json >Content-Type "application/manifest+json"
	@pas_assets not path /_astro/* /fonts/* /icones/* /apple-touch-icon.png /apple-touch-icon-precomposed.png /favicon.ico /manifest.json
	header @pas_assets Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Page 404 du site
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	# Jumeaux .br / .gz écrits au build (scripts/precompression.mjs) : servis tels quels, sans recompression
	file_server {
		precompressed br gzip
	}
}
