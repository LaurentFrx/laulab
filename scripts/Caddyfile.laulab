# Bloc Caddy pour laulab.feroux.fr — à fusionner dans le Caddyfile du VPS.
# Le dossier dist/ est produit par scripts/deploy-vps.sh.
laulab.feroux.fr {
	root * /srv/laulab/dist
	encode zstd gzip
	file_server

	# Page 404 du site
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	header {
		# Polices et assets fingerprintés : cache long
		@assets path /_astro/* /fonts/*
		Cache-Control "public, max-age=31536000, immutable"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
